# URL du webhook Make (Integromat) ou Zapier appelé après chaque signature
WEBHOOK_URL=https://hook.make.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mot de passe pour accéder au tableau de bord (/ et /nouveau).
# Sans cette variable, le tableau de bord reste accessible à quiconque a l'URL.
ADMIN_PASSCODE=change-moi
